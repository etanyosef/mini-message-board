<%- include('../partials/header'); %>

<main>
    <div class="container">
        <h1><%= pageTitle %></h1>

        <form method="POST" action="/new">
            <label>
                <span>User</span>
                <%- include('../partials/validationErrors', { errors: locals.errors, path: 'username' }); %>
                <input type="text" name="username" required>
            </label>

            <label>
                <span>Message</span>
                <%- include('../partials/validationErrors', { errors: locals.errors, path: 'text' }); %>
                <textarea name="text" rows="5" required></textarea>
            </label>

            <button type="submit">Send Message &#10148;</button>
        </form>
    </div>
</main>

<%- include('../partials/footer') %>