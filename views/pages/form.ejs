<%- include('../partials/header') %>

<main>
    <div class="container">
        <h1><%= pageTitle %></h1>

        <form method="POST" action="/new">
            <label>
                <span>User</span>
                <input type="text" name="messageUser" required>
            </label>

            <label>
                <span>Message</span>
                <textarea name="messageText" rows="5" required></textarea>
            </label>

            <button type="submit">Send Message &#10148;</button>
        </form>
    </div>
</main>

<%- include('../partials/footer') %>