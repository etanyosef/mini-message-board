<%- include('../partials/header') %>

<main>
    <div class="container">
        <h1><%= pageTitle %></h1>
        
        <a href="/" class="go-back-btn">&larr; Go back</a>

        <div class="message">
            <div class="message-head">
                <span class="user">
                    <%= message.user %>
                </span>
                <span class="date">
                    <%= message.added.toLocaleString('en-US') %>
                </span>
            </div>
            <p>
                <%= message.text %>
            </p>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>